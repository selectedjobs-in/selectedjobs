# SelectedJobs.in Apache & LiteSpeed Configuration for Hostinger Single Hosting
# Permanent Anti-Cache & Instant Invalidation Engine

Options -Indexes
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Disable LiteSpeed Cache for all requests
  RewriteRule .* - [E=Cache-Control:no-cache]
  RewriteRule .* - [E=Cache-Control:max-age=0]

  # Protect data folder from direct public web access
  RewriteRule ^data/ - [F,L]

  # Route API endpoints
  RewriteRule ^api/jobs$ api.php?action=get_jobs [QSA,L]
  RewriteRule ^api/admin/jobs$ api.php?action=admin_jobs [QSA,L]
  RewriteRule ^api/admin/auth$ api.php?action=admin_auth [QSA,L]

  # Route Clean Frontend URLs
  RewriteRule ^jobs/([a-zA-Z0-9_\-]+)/?$ job.html?id=$1 [QSA,L]
  RewriteRule ^blogs/([a-zA-Z0-9_\-]+)/?$ blog.html?id=$1 [QSA,L]
  RewriteRule ^blogs/?$ index.html?category=CAREER%20BLOGS%20%26%20GUIDES [QSA,L]
  RewriteRule ^blog/?$ index.html?category=CAREER%20BLOGS%20%26%20GUIDES [QSA,L]
  RewriteRule ^post-job/?$ post-job.html [QSA,L]
  RewriteRule ^admin/?$ admin.html [QSA,L]

  # Existing files and directories serve as-is
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
</IfModule>

# Disable mod_expires for HTML, PHP, and JSON so browser never caches stale versions
<IfModule mod_expires.c>
  ExpiresActive Off
</IfModule>

# Permanent Anti-Cache Headers: Force Browsers (Mobile + Desktop), CDNs & LiteSpeed to NEVER cache dynamic files
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Apply strict anti-cache headers to HTML, PHP, and JSON files
  <FilesMatch "\.(html|htm|php|json)$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0, s-maxage=0, post-check=0, pre-check=0"
    Header always set Pragma "no-cache"
    Header always set Expires "-1"
    Header always set X-Accel-Expires "0"
    Header always set Surrogate-Control "no-store"
    Header always set X-LiteSpeed-Cache-Control "no-cache, no-store, max-age=0"
  </FilesMatch>
</IfModule>

# Disable LiteSpeed Server Cache so updates appear immediately across all devices
<IfModule LiteSpeed>
  CacheLookup off
</IfModule>

# Compression for Speed
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>


